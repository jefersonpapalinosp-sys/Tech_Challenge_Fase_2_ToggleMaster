# Copie para .env.aws e preencha somente na máquina de execução.
# .env.aws já está no .gitignore. Nunca envie credenciais para o Git.

# Credenciais temporárias do AWS Academy. Em EC2/EKS com LabRole e IMDS
# corretamente configurado, deixe estas três variáveis vazias.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# RDS privados na VPC vpc-0ecf1861ef9b39911.
# DBName não foi definido na criação, portanto o banco atual é "postgres".
# Substitua cada marcador pela senha URL-encoded do segredo indicado.
AUTH_DATABASE_URL=postgres://postgres:<AUTH_PASSWORD_URL_ENCODED>@db-auth-service.c7yswag6apmj.us-east-1.rds.amazonaws.com:5432/postgres?sslmode=require
FLAGS_DATABASE_URL=postgres://postgres:<FLAG_PASSWORD_URL_ENCODED>@db-flag-service.c7yswag6apmj.us-east-1.rds.amazonaws.com:5432/postgres?sslmode=require
TARGETING_DATABASE_URL=postgres://postgres:<TARGETING_PASSWORD_URL_ENCODED>@db-targeting-service.c7yswag6apmj.us-east-1.rds.amazonaws.com:5432/postgres?sslmode=require

# ElastiCache: cluster mode habilitado, TLS obrigatório e AUTH token.
# O token também deve ser URL-encoded.
REDIS_URL=rediss://:<REDIS_AUTH_TOKEN_URL_ENCODED>@clustercfg.redis-evaluation-service.ifqrsm.use1.cache.amazonaws.com:6379

# Segredos das aplicações.
MASTER_KEY=<MASTER_KEY>
SERVICE_API_KEY=<SERVICE_API_KEY_GERADA_PELO_AUTH>

# Portas publicadas pelo host que executar o Compose.
AUTH_PORT=8001
FLAG_PORT=8002
TARGETING_PORT=8003
EVALUATION_PORT=8004
ANALYTICS_PORT=8005

# Referência dos segredos RDS gerenciados pela AWS (não são valores secretos):
# auth:      rds!db-3880278a-f27d-4bd3-8bf5-d92529e028fc
# flag:      rds!db-95131639-571a-4314-9298-2c941e638814
# targeting: rds!db-8d46442b-245d-4f7c-893e-5c96a081d572
