# Copie para .env.aws e preencha somente na máquina de execução.
# .env.aws já está no .gitignore. Nunca envie credenciais para o Git.

# Credenciais temporárias do AWS Academy. Em EC2/EKS com LabRole e IMDS
# corretamente configurado, deixe estas três variáveis vazias.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# RDS privados na VPC vpc-09d66ad83422a42ee.
# DBName não foi definido na criação, portanto o banco atual é "postgres".
# Substitua cada marcador pela senha URL-encoded do segredo indicado.
AUTH_DATABASE_URL=postgres://postgres:<AUTH_PASSWORD_URL_ENCODED>@db-authservice.cjsc4kc2abeq.us-east-1.rds.amazonaws.com:5432/postgres?sslmode=require
FLAGS_DATABASE_URL=postgres://postgres:<FLAG_PASSWORD_URL_ENCODED>@dbflags.cjsc4kc2abeq.us-east-1.rds.amazonaws.com:5432/postgres?sslmode=require
TARGETING_DATABASE_URL=postgres://postgres:<TARGETING_PASSWORD_URL_ENCODED>@dbtargeting.cjsc4kc2abeq.us-east-1.rds.amazonaws.com:5432/postgres?sslmode=require

# ElastiCache atual: cluster mode, TLS e AUTH token obrigatório.
REDIS_URL=rediss://:<REDIS_AUTH_TOKEN_URL_ENCODED>@clustercfg.redisevaluation.ymqqul.use1.cache.amazonaws.com:6379

# Segredos das aplicações.
MASTER_KEY=<MASTER_KEY>
SERVICE_API_KEY=<SERVICE_API_KEY_GERADA_PELO_AUTH>

# Portas publicadas pelo host que executar o Compose.
AUTH_PORT=8001
FLAG_PORT=8002
TARGETING_PORT=8003
EVALUATION_PORT=8004
ANALYTICS_PORT=8005

# Referência dos segredos RDS gerenciados pela AWS (não são valores secretos):
# auth:      rds!db-750f0e87-8f0f-49c7-a257-7182b4f4eb46
# flag:      rds!db-6b65d7cf-6937-428e-8f5b-a8dcedc1240d
# targeting: rds!db-8fcfbb1e-0e14-4f73-8ecb-8ddda369f9ae
